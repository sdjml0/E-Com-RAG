# =====================================================================
# Multimodal E-Commerce RAG Microservice Environment Configuration
# =====================================================================

ENVIRONMENT=development
QDRANT_URL=:memory:
COLLECTION_NAME=ecommerce_products_v1

# ---------------------------------------------------------------------
# Google Gemini API Key (Required for AI Vision / Image Generation)
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# PostgreSQL Database Connection Settings (For Dataset Syncing)
# You can use individual fields OR a single DATABASE_URL string.
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Alternative Single Connection String Format:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres
